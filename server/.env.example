# --- Local development ---
PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
SEED_ADMIN_EMAIL=admin@sellix.software
SEED_ADMIN_PASSWORD=change-me-on-first-login

# Where the SQLite file lives. Defaults to server/data locally; on Railway this
# points at the mounted volume so the database survives redeploys.
# DATA_DIR=/data

# --- Railway / production ---
# PORT is injected by Railway — do not set it there.
# JWT_SECRET=<openssl rand -hex 32>
# DATA_DIR=/data
# CLIENT_ORIGIN=https://sellix.software,https://<your-app>.up.railway.app
# COOKIE_SECURE=true
# TRUST_PROXY=1
# SEED_ADMIN_EMAIL=admin@sellix.software
# SEED_ADMIN_PASSWORD=<a strong one-time password>

# Optional: seed the Windows installer on first boot when Admin has not uploaded yet.
# SETUP_SEED_PATH=/absolute/path/to/Sellix Setup.exe

# Only needed if the frontend is hosted on a different domain than the API:
# COOKIE_SAMESITE=none
